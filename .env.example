# Pharma Job Hunter AI - Environment Configuration

# Application
APP_NAME="Pharma Job Hunter AI"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="pharma-job-hunter-insecure-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default for zero-setup development; set to postgresql://user:pass@localhost:5432/pharma_jobs for production
DATABASE_URL="sqlite:///./pharma_jobs.db"
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/pharma_jobs"

# Redis & Celery (Optional / Production)
REDIS_URL="redis://localhost:6379/0"

# LLM / AI Configuration (Configurable OpenAI / Azure / Local)
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Storage Configuration
UPLOAD_DIR="./uploads"
RESUME_OUTPUT_DIR="./generated_resumes"

# Job Freshness & Verification Config
JOB_FRESHNESS_DAYS=7
JOB_RECHECK_INTERVAL_HOURS=12
DISCOVERY_CRON_HOURS=6

# Notifications (Optional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@pharmajobhunter.ai"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Application Automation
APPLICATION_MODE="Assisted application with approval"
HEADLESS_BROWSER=true
BROWSER_TIMEOUT_MS=30000

